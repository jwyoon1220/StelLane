{
  "chapters": [
    {
      "id": "ch1_fall_and_ark",
      "title": "추락과 방주",
      "description": "하늘 도시 붕괴 후 지상에 떨어진 멤버들이 소멸 직전 음악 홀 '스텔라이브'를 발견하고 모인다.",
      "order": 1,
      "cutscenes": [
        {
          "id": "ch1_opening",
          "timing": "before_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "하늘 도시가 무너져 내린다.\n빛의 파편들이 밤하늘을 가르며 지상으로 쏟아진다." },
            { "character": "유니", "characterImage": "yuni.png", "position": "center", "text": "흐아... 여기가 어디야? 다들... 괜찮아?" },
            { "character": "타비", "characterImage": "tabi.png", "position": "left", "text": "나는... 괜찮아. 근데 뭔가 이상해. 힘이... 하나도 안 느껴져." },
            { "character": "나나", "characterImage": "nana.png", "position": "right", "text": "저기 봐, 하늘이... 우리가 있던 곳이 사라지고 있어." },
            { "character": "리코", "characterImage": "riko.png", "position": "left", "text": "패닉 상태로는 아무것도 못 해. 일단 안전한 곳부터 찾자." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "폐허 사이로 희미한 빛이 새어 나오는 건물 하나가 보인다.\n낡은 간판에는 음표 문양이 새겨져 있었다." }
          ]
        },
        {
          "id": "ch1_closing",
          "timing": "after_song_0",
          "backgroundImage": "stellive_music_hall.jpg",
          "dialogues": [
            { "character": "유니", "characterImage": "yuni.png", "position": "center", "text": "방금... 우리 함께 노래하니까 뭔가 확실해졌어." },
            { "character": "타비", "characterImage": "tabi.png", "position": "left", "text": "이 홀 안에서는 우리가 사라지지 않는 것 같아." },
            { "character": "나나", "characterImage": "nana.png", "position": "right", "text": "저기... 간판을 봐. '스텔라이브'라고 적혀 있어." },
            { "character": "리코", "characterImage": "riko.png", "position": "left", "text": "소멸을 막는 방주. 여기서부터 다시 시작하자." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "여섯 개의 별 중 넷이 모였다.\n나머지 별들은 아직, 어둠 속에 있다." }
          ]
        }
      ],
      "requiredSongs": [
        { "songEntryId": "Millky_Way", "difficulty": "easy", "minAccuracy": 0, "description": "튜토리얼 및 프롤로그 스테이지" }
      ],
      "rewards": { "unlockNextChapter": true, "unlockedCharacters": [], "unlockedEmojis": [] }
    },
    {
      "id": "ch2_alignment_of_galaxy",
      "title": "은하수의 정렬",
      "description": "각자의 상처와 정체를 숨긴 2기생(유니버스) 멤버들이 음악을 통해 각자의 별을 각인시킨다.",
      "order": 2,
      "cutscenes": [
        {
          "id": "ch2_opening",
          "timing": "before_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "며칠이 지났다. 홀에는 하나둘 낯익은 얼굴들이 모여든다 — 2기생, '유니버스'." },
            { "character": "타비", "characterImage": "tabi.png", "position": "left", "text": "다들... 각자 사정이 있었던 거지? 나도 말 못 한 게 많아." },
            { "character": "나나", "characterImage": "nana.png", "position": "right", "text": "나는... 무서워서 숨어 있었어. 노래하면 들킬 것 같아서." },
            { "character": "히나", "characterImage": "hina.png", "position": "center", "text": "숨길 필요 없어! 우리 모두 별이잖아. 각자의 색으로 빛나면 돼." },
            { "character": "리코", "characterImage": "riko.png", "position": "left", "text": "그래, 처음부터 완벽할 필요 없어. 부딪히면서 맞춰가면 되지." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "서로 다른 상처를 지닌 네 개의 별이, 조심스레 첫 화음을 맞춰본다." }
          ]
        },
        {
          "id": "ch2_interlude",
          "timing": "after_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "나나", "characterImage": "nana.png", "position": "right", "text": "방금... 우리 목소리가 겹쳤을 때, 뭔가 반짝였어!" },
            { "character": "타비", "characterImage": "tabi.png", "position": "left", "text": "진짜야! 다들 조금씩 밝아지고 있어." },
            { "character": "히나", "characterImage": "hina.png", "position": "center", "text": "이게 바로 '정렬'이라는 걸까? 우리 넷의 별이 하나의 선으로 이어지는 거." },
            { "character": "리코", "characterImage": "riko.png", "position": "right", "text": "그럼 이번엔 제대로 맞춰보자. 처음부터 끝까지, 넷이 함께." }
          ]
        },
        {
          "id": "ch2_climax",
          "timing": "after_song_1",
          "backgroundImage": "stellive_music_hall.jpg",
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "무대 전체를 채우던 흑백의 게이지가, 네 개의 색으로 물들며 폭발하듯 반전된다." },
            { "character": "히나", "characterImage": "hina.png", "position": "center", "text": "봐, 우리 모두... 색깔을 되찾았어!" },
            { "character": "타비", "characterImage": "tabi.png", "position": "left", "text": "이제야 진짜 '유니버스'가 된 기분이야." },
            { "character": "나나", "characterImage": "nana.png", "position": "right", "text": "숨을 필요 없었네. 처음부터." },
            { "character": "리코", "characterImage": "riko.png", "position": "left", "text": "다음 별을 찾으러 가자. 아직 어둠 속에 있는 그 애를." }
          ]
        }
      ],
      "requiredSongs": [
        { "songEntryId": "dear_my_fairy", "difficulty": "Normal", "minAccuracy": 0, "description": "유닛 호흡 스테이지" },
        { "songEntryId": "stars_align", "difficulty": "Normal", "minAccuracy": 0, "description": "2기생 클라이맥스 — 4개의 별이 정렬하며 게이지가 컬러로 반전" }
      ],
      "rewards": { "unlockNextChapter": true, "unlockedCharacters": ["히나"], "unlockedEmojis": [] }
    },
    {
      "id": "ch3_2000_years_silence",
      "title": "2,000년의 정적",
      "description": "음향 콘솔에 발생한 공허 노이즈 속에서, 2,000년 동안 빛과 목소리를 잃어가던 마룡 후야의 구조 신호를 포착한다.",
      "order": 3,
      "cutscenes": [
        {
          "id": "ch3_opening",
          "timing": "before_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "음향 콘솔에서 정체불명의 공허 노이즈가 감지된다.\n신호는 미약하지만, 분명 존재했다." },
            { "character": "마시로", "characterImage": "mashiro.png", "position": "left", "text": "이 파형... 이상해. 음악이 아니라, 비명 같아." },
            { "character": "유니", "characterImage": "yuni.png", "position": "right", "text": "비명이라니, 무슨 뜻이야?" },
            { "character": "마시로", "characterImage": "mashiro.png", "position": "left", "text": "2,000년 동안 아무도 듣지 못한 소리인 것 같아. 완전히 지워지기 직전의..." },
            { "character": "리코", "characterImage": "riko.png", "position": "right", "text": "누군가 저 안에 있다는 거네. 그것도 아주 오랫동안." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "콘솔의 화면에 파형 하나가 위태롭게 깜빡인다. 곧 사라질 듯이." }
          ]
        },
        {
          "id": "ch3_restoration",
          "timing": "after_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "무음 속에서 시작된 연주가, 완벽한 타이밍의 리듬으로 보컬의 파편을 하나씩 되살려낸다." },
            { "character": "마시로", "characterImage": "mashiro.png", "position": "left", "text": "목소리가... 복원되고 있어! 정말 누군가 있어!" },
            { "character": "유니", "characterImage": "yuni.png", "position": "right", "text": "거기, 들려요? 우리가 지금 갈게요!" },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "희미한 응답이 노이즈 사이로 스쳐 지나간다. 2,000년만의 첫 목소리." }
          ]
        },
        {
          "id": "ch3_closing",
          "timing": "after_song_1",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "판정선이 소멸하는 회랑 끝, 빛을 잃은 거대한 형체가 웅크리고 있었다." },
            { "character": "유니", "characterImage": "yuni.png", "position": "center", "text": "...이제 괜찮아. 우리가 찾았어." },
            { "character": "리코", "characterImage": "riko.png", "position": "right", "text": "저건... 마룡? 2,000년이나 여기 갇혀 있었던 거야?" },
            { "character": "마시로", "characterImage": "mashiro.png", "position": "left", "text": "아직 숨은 붙어 있어. 하지만 시간이 얼마 없어." },
            { "character": "후야", "characterImage": "huya.png", "position": "center", "text": "(아주 작게)... 누구...?" },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "정적 속에서, 아주 작은 심장 박동 같은 리듬이 다시 뛰기 시작한다." }
          ]
        }
      ],
      "requiredSongs": [
        { "songEntryId": "void_noise", "difficulty": "Hard", "minAccuracy": 0, "description": "무음으로 시작해 PERFECT 판정 시 보컬이 복원되는 음향 복원 채보" },
        { "songEntryId": "corridor_2000_years", "difficulty": "Hard", "minAccuracy": 0, "description": "판정선이 실시간으로 소멸하는 타임 어택 스테이지" }
      ],
      "rewards": { "unlockNextChapter": true, "unlockedCharacters": [], "unlockedEmojis": [] }
    },
    {
      "id": "ch4_star_trail",
      "title": "별의 궤적: STAR TRAIL",
      "description": "유니가 손을 내밀고 멤버들이 이름을 부르자, 마룡 상태였던 후야가 빛을 되찾고 1기생(Everys)으로 완전히 합류한다.",
      "order": 4,
      "cutscenes": [
        {
          "id": "ch4_opening",
          "timing": "before_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "빛을 잃은 마룡 앞에서, 유니가 조용히 손을 내민다." },
            { "character": "유니", "characterImage": "yuni.png", "position": "left", "text": "이름이... 후야, 맞지? 2,000년 전에도, 지금도 — 네 목소리를 기다린 사람들이 있어." },
            { "character": "후야", "characterImage": "huya.png", "position": "right", "text": "(갈라진 목소리로) ...내 목소리 따위, 이제 아무도..." },
            { "character": "타비", "characterImage": "tabi.png", "position": "left", "text": "아니, 우리가 들을게. 지금, 여기서." },
            { "character": "나나", "characterImage": "nana.png", "position": "right", "text": "노래해줘, 후야. 우리도 함께 부를게." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "여섯 개의 목소리가 하나의 선율로 겹쳐지기 시작한다." }
          ]
        },
        {
          "id": "ch4_interlude",
          "timing": "after_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "후야의 몸을 뒤덮었던 어둠이, 노래가 이어질 때마다 조금씩 빛의 조각으로 부서져 내린다." },
            { "character": "후야", "characterImage": "huya.png", "position": "right", "text": "목소리가... 다시 나와. 2,000년 만에..." },
            { "character": "유니", "characterImage": "yuni.png", "position": "left", "text": "이제 시작이야. 우리랑 같이 완전한 노래를, 처음부터." },
            { "character": "리코", "characterImage": "riko.png", "position": "center", "text": "1기생 자리 하나가 비어 있었어. 원래 네 자리였나 봐." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "후야의 눈에 다시 별빛이 맺힌다." }
          ]
        },
        {
          "id": "ch4_closing",
          "timing": "after_song_1",
          "backgroundImage": "stellive_music_hall.jpg",
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "완전히 빛을 되찾은 후야가, 1기생 'Everys'의 마지막 별로 궤적 위에 선다." },
            { "character": "후야", "characterImage": "huya.png", "position": "center", "text": "다녀왔습니다 — 아니, 처음 왔습니다. 잘 부탁해, 모두." },
            { "character": "유니", "characterImage": "yuni.png", "position": "left", "text": "환영해, 후야. 이제 진짜 우리 궤적이 완성됐어." },
            { "character": "리제", "characterImage": "lize2.png", "position": "right", "text": "짜잔, 이걸로 Everys 전원 집합이네!" },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "별의 궤적 위로, 여섯 개의 빛이 하나의 길을 그리며 흐른다." }
          ]
        }
      ],
      "requiredSongs": [
        { "songEntryId": "yuni_huya_duet", "difficulty": "Hard", "minAccuracy": 0, "description": "실시간 보컬 스위칭 채보" },
        { "songEntryId": "STAR_TRAIL", "difficulty": "Hard", "minAccuracy": 0, "description": "후야 합류 기념 1기생 메인 단체곡 풀 버전" }
      ],
      "rewards": { "unlockNextChapter": true, "unlockedCharacters": ["후야", "리제"], "unlockedEmojis": [] }
    },
    {
      "id": "ch5_colorful_strokes",
      "title": "칠색의 자화상: Colorful Strokes",
      "description": "3기생 클리셰가 데뷔 곡 'Our Tales'의 기억을 밑그림 삼아, 세계의 망각에 맞서 4인 4색의 가장 솔직한 개성을 캔버스 위에 폭발시킨다.",
      "order": 5,
      "cutscenes": [
        {
          "id": "ch5_opening",
          "timing": "before_song_0",
          "backgroundImage": null,
          "dialogues": [
            { "character": "narrator", "characterImage": null, "position": "center", "text": "3기생 '클리셰'의 데뷔 곡 'Our Tales'의 악보 위에, 네 개의 새로운 색이 덧그려지기 시작한다." },
            { "character": "시부키", "characterImage": "shibuki.png", "position": "center", "text": "내 차례, 내 차례! 제일 상큼하고 팝핑하게 갈 거야!" },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "세계의 망각에 맞서, 클리셰는 각자의 색으로 캔버스를 채워나가기로 한다." }
          ]
        },
        {
          "id": "ch5_interlude_rin",
          "timing": "before_song_1",
          "backgroundImage": null,
          "dialogues": [
            { "character": "린", "characterImage": "rin.png", "position": "center", "text": "다음은 나야. 속도로 승부를 볼 시간이지." },
            { "character": "시부키", "characterImage": "shibuki.png", "position": "left", "text": "린 선배 빠르기 실화야?! 나 방금 두 배속으로 보는 줄..." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "고속으로 쏟아지는 폭타 속에서도, 린의 손끝은 흔들림이 없었다." }
          ]
        },
        {
          "id": "ch5_interlude_nana",
          "timing": "before_song_2",
          "backgroundImage": null,
          "dialogues": [
            { "character": "나나", "characterImage": "nana.png", "position": "center", "text": "이번엔... 조용히, 그림자처럼 다가갈게." },
            { "character": "리코", "characterImage": "riko.png", "position": "right", "text": "나나가 저렇게 능글맞을 줄이야." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "트랩 비트 속에 숨겨진 나나의 목소리가, 은밀하게 관객을 사로잡는다." }
          ]
        },
        {
          "id": "ch5_interlude_riko",
          "timing": "before_song_3",
          "backgroundImage": null,
          "dialogues": [
            { "character": "리코", "characterImage": "riko.png", "position": "center", "text": "자, 마지막 페이크 들어갑니다 — 속아줄 준비 됐어?" },
            { "character": "나나", "characterImage": "nana.png", "position": "left", "text": "얄밉지만... 저게 리코의 매력이지." },
            { "character": "narrator", "characterImage": null, "position": "center", "text": "짓궂은 리듬의 함정들이 무대 곳곳에 숨어든다." }
          ]
        },
        {
          "id": "ch5_climax_intro",
          "timing": "before_song_4",
          "backgroundImage": "stellive_music_hall.jpg",
          "dialogues": [
